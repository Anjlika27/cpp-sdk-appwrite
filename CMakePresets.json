{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg-release",
            "displayName": "Release build with vcpkg toolchain",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "C:/Users/hp/Desktop/Anjlika 2025/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "vcpkg-debug",
            "displayName": "Debug build with vcpkg toolchain",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "C:/Users/hp/Desktop/Anjlika 2025/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "vcpkg-release",
            "targets": [
                "updateMessages"
            ],
            "postBuild": {
                "commands": [
                    {
                        "command": "${sourceDir}/build/updateMessages"
                    }
                ]
            }
        },
        {
            "name": "debug",
            "configurePreset": "vcpkg-debug",
            "targets": [
                "updateMessages"
            ],
            "postBuild": {
                "commands": [
                    {
                        "command": "${sourceDir}/build/updateMessages"
                    }
                ]
            }
        }
    ],
    "testPresets": []
}